# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides. Leave these unset: Collate probes at startup and picks a
# model the key can actually call, then rotates through the rest as each one's
# daily allowance runs out. Pinning a name is how you get a 404 six months from
# now - gemini-2.5-flash was the obvious default when this was written and is
# already retired.
# COLLATE_MODEL=gemini-3.8-flash
# COLLATE_RPM=15
# COLLATE_WORKERS=6
